{
  "name": "QR Generátor",
  "short_name": "QR Generátor",
  "description": "Jednoduchá offline aplikace pro tvorbu QR kódů z textu, odkazu, Wi-Fi, kontaktu, e-mailu, SMS, události a dalších formátů.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#121821",
  "theme_color": "#121821",
  "lang": "cs",
  "icons": [
    { "src": "assets/favicon-32.png", "sizes": "32x32", "type": "image/png" },
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
